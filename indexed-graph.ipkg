package indexed-graph

authors    = "stefan-hoeck"
brief      = "Array-backed, order indexed, sparse, simple graphs in Idris2"
version    = 0.1.0
readme     = "README.md"
license    = "BSD-3 Clause"

sourcedir  = "src"
depends    = base    >= 0.5.1
           , array
           , containers

modules = Data.AssocList.Indexed

        , Data.Graph.Indexed
        , Data.Graph.Indexed.Edge

        , Data.Graph
        , Data.Graph.Subgraph
        , Data.Graph.Query.BFS
        , Data.Graph.Query.DFS
        , Data.Graph.Query.Subgraph
        , Data.Graph.Query.Visited
        , Data.Graph.Query.Util

        , Data.Graph.Ring.Relevant
        , Data.Graph.Ring.Relevant.Candidates
        , Data.Graph.Ring.Relevant.ShortestPath
        , Data.Graph.Ring.Relevant.Types

        , Data.Graph.Ring.Bonds
        , Data.Graph.Ring.Systems
        , Data.Graph.Ring.Util

        , Data.Graph.Util.Bipartite
        , Data.Graph.Util.DisjointSet
